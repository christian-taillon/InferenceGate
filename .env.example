# InferenceGate Configuration Template
# Copy this to .env and fill in your values

# --- Upstream AI Provider ---
# Preferred provider variables used by the LiteLLM proxy itself.
LITELLM_API_BASE='https://api.openai.com/v1'
LITELLM_API_KEY='sk-your-upstream-provider-key'

# OpenAI-compatible alias variables used by helper scripts and direct client tests.
# You can define these instead of the LiteLLM variables above, or define both.
baseURL='https://api.openai.com/v1'
OPENAI_API_KEY='sk-your-openai-compatible-key'

# Ollama Cloud API key (https://ollama.com). When LITELLM_API_BASE points to
# https://ollama.com/v1, this is used as a fallback for LITELLM_API_KEY.
OLLAMA_API_KEY='your-ollama-cloud-api-key'

# Optional upstream model override for demo/provider helper scripts.
MODEL='qwen3.6:35b-a3b-q4_K_M-ctx128k'

# --- Gateway Security ---
# The master key required by clients to connect to this InferenceGate proxy.
# MUST be set to a high-entropy value — the proxy refuses to start with the
# insecure default "sk-inference-gate-v1".
# Generate one with: python -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
LITELLM_MASTER_KEY='sk-REPLACE-WITH-YOUR-OWN-HIGH-ENTROPY-KEY'

# --- LlamaGuard Configuration ---
# The model used for probabilistic safety assessment (Phase 3 + Response Guard).
# Supported options: openai/llama-guard3:1b, ollama/llama-guard3:8b, etc.
LLAMA_GUARD_MODEL='openai/llama-guard3:1b'

# Optional dedicated provider for the LlamaGuard call. If omitted, it falls back to
# LLAMA_GUARD_API_BASE -> LITELLM_API_BASE and LLAMA_GUARD_API_KEY -> LITELLM_API_KEY.
LLAMA_GUARD_API_BASE='https://api.openai.com/v1'
LLAMA_GUARD_API_KEY='sk-your-guard-provider-key'

# --- Llama Prompt Guard Configuration ---
# The model used to detect prompt injections and jailbreak attempts (Phase 2).
# Groq uses the normal OpenAI-compatible chat completions API.
# vLLM-style providers can still use a classification endpoint (`/classify`).
LLAMA_PROMPT_GUARD_MODEL='meta-llama/llama-prompt-guard-2-86m'

# Optional dedicated provider for the Llama Prompt Guard call. If omitted, it falls
# back to LLAMA_PROMPT_GUARD_API_BASE -> LITELLM_API_BASE and
# LLAMA_PROMPT_GUARD_API_KEY -> LITELLM_API_KEY.
LLAMA_PROMPT_GUARD_API_BASE='https://api.openai.com/v1'
LLAMA_PROMPT_GUARD_API_KEY='sk-your-prompt-guard-provider-key'

# --- Local Prompt Guard (on-device, optional) ---
# Loads a HuggingFace text-classification model directly via transformers.
# Runs entirely on-device — no API calls needed. Requires the local-prompt-guard
# extra: uv sync --extra local-prompt-guard
#
# When set, an additional guardrail pipe (prompt-guard-local) is activated
# alongside the API-based llama-prompt-guard shield.
PROMPT_GUARD_LOCAL_MODEL='meta-llama/Llama-Prompt-Guard-2-86M'
# Minimum score threshold for blocking (0.0–1.0). Default: 0.5
PROMPT_GUARD_LOCAL_THRESHOLD='0.5'

# --- Shield Behavior ---
# What happens when a shield itself malfunctions (guard endpoint down,
# malformed guard output, missing config): 'open' logs and allows the
# request through; 'closed' denies it. Overridable per guardrail via
# litellm_params.fail_mode in config.yaml.
INFERENCE_GATE_FAIL_MODE='open'

# Malicious-score cutoff (0.0-1.0) for the remote Llama Prompt Guard shield.
LLAMA_PROMPT_GUARD_THRESHOLD='0.5'

# --- Runtime Overrides ---
# Optional alternate LiteLLM config path.
LITELLM_CONFIG='config.yaml'

# Optional demo tuning.
DEMO_MAX_TOKENS='80'

# --- Demo & UI Settings ---
# Friendly name of the model to display in the demo terminal
DEMO_MODEL_NAME='qwen3.6:35b-a3b-q4_K_M-ctx128k'